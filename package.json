{
  "name": "hotfix",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "APP_URL=http://localhost:3001 DOMAIN=localhost node scripts/run-with-env.mjs .env.dev ./node_modules/.bin/next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=0.0.0.0 node --env-file=.env.production .next/standalone/server.js",
    "db:reset": "node --env-file=.env.dev ./node_modules/tsx/dist/cli.mjs scripts/reset-db.ts",
    "db:seed:testing": "node --env-file=.env.dev ./node_modules/tsx/dist/cli.mjs scripts/seed-testing-marketplace.ts",
    "db:sync:facebook-pages": "node --env-file=.env.dev ./node_modules/tsx/dist/cli.mjs scripts/sync-facebook-page-leads-to-dev.ts",
    "db:migrate-schema": "node --env-file=.env.dev ./node_modules/tsx/dist/cli.mjs scripts/migrate-db-schema.ts",
    "db:init:production": "NODE_ENV=production node --env-file=.env.production ./node_modules/tsx/dist/cli.mjs scripts/init-production-db.ts",
    "db:provision-admin": "NODE_ENV=production node --env-file=.env.production --env-file-if-exists=.env.production.admin ./node_modules/tsx/dist/cli.mjs scripts/provision-production-admin.ts",
    "qa:flows": "node --env-file=.env.dev ./node_modules/tsx/dist/cli.mjs scripts/qa-role-flows.ts",
    "qa:ui": "node --env-file=.env.dev ./node_modules/tsx/dist/cli.mjs scripts/qa-deep-ui.ts",
    "deploy:dev": "bash scripts/deploy-dev.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "lint": "eslint",
    "test": "NODE_ENV=test MONGODB_DATABASE=hotfix_test ENABLE_DATABASE_SEEDING=true node --env-file=.env.dev ./node_modules/vitest/vitest.mjs run",
    "test:watch": "NODE_ENV=test MONGODB_DATABASE=hotfix_test ENABLE_DATABASE_SEEDING=true node --env-file=.env.dev ./node_modules/vitest/vitest.mjs",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.96.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "mongodb": "^7.2.0",
    "next": "16.2.10",
    "next-intl": "^4.12.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.72.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
