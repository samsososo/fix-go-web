# Comma-separated numeric IDs for Facebook Pages managed by this user.
FACEBOOK_PAGE_IDS=123456789012345,987654321098765

# Long-lived USER access token. The script exchanges it for Page access
# tokens through GET /me/accounts and never stores the Page tokens.
FACEBOOK_USER_ACCESS_TOKEN=replace_with_long_lived_user_access_token

# Optional. Relative paths are resolved from this .env file's directory.
FACEBOOK_SQLITE_PATH=../../data/facebook-page-posts.sqlite3
