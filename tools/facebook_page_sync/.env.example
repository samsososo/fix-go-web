# Copy this file to .env under umask 077 and chmod the result to exactly 0600.
# The sync refuses symlinks, hard links, non-regular files, other owners, or
# broader modes.

# Comma-separated numeric IDs for Facebook Pages managed by this user.
FACEBOOK_PAGE_IDS=123456789012345,987654321098765

# Long-lived USER access token. The script exchanges it for Page access
# tokens through GET /me/accounts and never stores the Page tokens.
FACEBOOK_USER_ACCESS_TOKEN=replace_with_long_lived_user_access_token

# Meta Graph API version used for every new request URL.
FACEBOOK_GRAPH_API_VERSION=v26.0

# When a Page has no post checkpoint, only keep posts created within this many
# days. Subsequent runs with a checkpoint continue incrementally from it.
FACEBOOK_INITIAL_LOOKBACK_DAYS=14

# Optional. Relative paths are resolved from this .env file's directory.
FACEBOOK_SQLITE_PATH=../../data/private-runs/facebook-pages/posts.sqlite3
